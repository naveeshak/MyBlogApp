<?xml version="1.0" encoding="utf-8"?>
<!-- Screen layout for creating a new blog message -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F3"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header with back button and screen title -->
        <LinearLayout
            android:id="@+id/createHeader"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#1F6B2A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/backArrowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="New Message"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:text="Title"
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Input field for message title -->
        <EditText
            android:id="@+id/titleInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/form_input_background"
            android:hint="Enter message title"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:text="Message"
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Input field for blog message content -->
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/form_input_background"
            android:gravity="top|start"
            android:hint="Write your message here..."
            android:padding="14dp"
            android:textSize="14sp" />

        <!-- Shows selected camera or gallery image preview -->
        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="18dp"
            android:adjustViewBounds="true"
            android:background="#DDDDDD"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Buttons for attaching image and saving message -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/attachImageButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/attach_button_background"
            android:drawableStart="@android:drawable/ic_menu_camera"
            android:drawablePadding="10dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Attach Image"
            android:textAllCaps="false"
            android:textColor="#1F6B2A"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/saveMessageButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/green_button_background"
            android:text="Save Message"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>